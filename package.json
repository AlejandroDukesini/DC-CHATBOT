{
  "name": "dc-chatbot",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "author": "Café Con Alejo (https://github.com/AlejandroDukesini)",
  "type": "module",
  "description": "Bot de Discord modular (IA investigadora, moderación, economía, radio, banners) con demo web.",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "bot:install": "npm install --prefix apps/bot",
    "bot": "npm start --prefix apps/bot",
    "deploy-commands": "npm run deploy-commands --prefix apps/bot",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "vitest": "^5.0.3"
  }
}

# ─── Obligatorio para el bot ───────────────────────────────
# https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=
# ID de la aplicación (General Information → Application ID)
DISCORD_CLIENT_ID=
# Opcional: ID de un servidor para registrar los slash commands al instante
DISCORD_GUILD_ID=

# ─── Opcional: proveedores de IA de pago (&pregunta, &imagen) ─
OPENAI_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=

# Opcional: cambia el modelo si el proveedor retira el predeterminado
# OPENAI_MODEL=gpt-4o-mini
# GROK_MODEL=grok-3-mini
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_IMAGE_MODEL=gpt-image-1

# ─── Opcional: almacenamiento ─────────────────────────────
# Carpeta de datos por servidor (por defecto apps/bot/data)
# BOT_DATA_DIR=

# ─── Opcional: investigador ───────────────────────────────
# Email de contacto que se envía a Wikipedia/Crossref (política de uso educado de sus APIs)
RESEARCH_CONTACT_EMAIL=

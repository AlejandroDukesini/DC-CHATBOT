# Token de tu Bot de Discord
# Obtén tu token en: https://discord.com/developers/applications
DISCORD_TOKEN=tu_token_de_discord_aqui

# API Key de OpenAI (ChatGPT)
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# API Key de xAI (Grok)
# Obtén tu API key en: https://console.x.ai/
GROK_API_KEY=tu_api_key_de_xai_aqui

# API Key de Google Generative AI (Gemini)
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_google_aqui
